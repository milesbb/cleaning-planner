{
  "name": "@cleaning-planner/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app-local.ts",
    "build": "node build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts --coverage"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1169.0",
    "@aws-sdk/client-dynamodb": "^3.1169.0",
    "@aws-sdk/client-lambda": "^3.1169.0",
    "@aws-sdk/client-scheduler": "^3.1169.0",
    "@aws-sdk/lib-dynamodb": "^3.1169.0",
    "@cleaning-planner/contracts": "^0.0.0",
    "@codegenie/serverless-express": "^5.0.0",
    "express": "^5.3.0"
  }
}
